{
  "name": "copi-from-chat",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Windows coding-agent CLI using Microsoft 365 Copilot in Edge as the model transport and Pi as the local agent runtime.",
  "bin": {
    "copi": "src/agent.js"
  },
  "files": [
    "src/**/*.js",
    "licenses/**",
    "README.md",
    "ROADMAP.md",
    "UPGRADE-SUMMARY.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/agent.js",
    "browser": "node src/index.js",
    "check": "node src/check.js",
    "test": "node --test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "playwright-core": "1.63.0"
  }
}
